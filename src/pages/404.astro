---
import Base from '../layouts/Base.astro';
---
{/*
  GitHub Pages serves /404.html for any unmatched path, in either language.
  A static host cannot know which locale the visitor came from, so this page
  says it in both rather than guessing wrong half the time.
*/}
<Base lang="en" path="/" noindex>
  <div class="wrap page">
    <p class="code mono">404</p>
    <h1 class="title">Page not found</h1>
    <p class="title title--fr" lang="fr">Page introuvable</p>

    <p class="prose">This page doesn’t exist, or it moved when the site was rebuilt.</p>
    <p class="prose" lang="fr">Cette page n’existe pas, ou elle a été déplacée lors de la refonte du site.</p>

    <p class="back"><a class="link mono" href="/">jeanbaptistebonvarlet.com</a></p>
  </div>
</Base>

<style>
  .page {
    padding-block: clamp(var(--s-7), 11vh, var(--s-9));
    display: flex; flex-direction: column;
    gap: var(--s-3);
  }
  .code {
    font-size: clamp(2.5rem, 2rem + 4vw, 4rem);
    line-height: 1;
    color: var(--text-dim);
    margin: 0;
  }
  .title { font-size: var(--t-md); margin: 0; }
  .title--fr { color: var(--text-dim); }
  .prose:first-of-type { margin-top: var(--s-4); }
  .back { margin-top: var(--s-4); font-size: var(--t-sm); }
</style>
