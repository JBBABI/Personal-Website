---
import { useTranslations, localePath, type Lang } from '../i18n/ui';
interface Props { lang: Lang; path?: string; }
const { lang, path = '/' } = Astro.props;
const t = useTranslations(lang);

---
<header class="nav">
  <div class="wrap nav__in">
    <a class="mark" href={localePath(lang, '/')} aria-label="Jean-Baptiste Bonvarlet — home">
      <span class="mark__id">JBB</span>
      <span class="mark__sep" aria-hidden="true"></span>
      <span class="mark__role label">{t('hero.role')}</span>
    </a>


    <nav class="nav__links" aria-label="Sections">
      <a class="nav__link label" href={localePath(lang, '/research')}
         aria-current={path === '/research' ? 'page' : undefined}>{t('nav.research')}</a>
    </nav>

    <div class="nav__tools">
      <div class="lang" role="group" aria-label="Language">
        <a class="lang__opt" href={localePath('en', path)} hreflang="en"
           aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        <a class="lang__opt" href={localePath('fr', path)} hreflang="fr"
           aria-current={lang === 'fr' ? 'true' : undefined}>FR</a>
      </div>
      <button id="theme-toggle" class="tgl" type="button" aria-label={t('theme.toggle')}>
        <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M8 1v2M8 13v2M1 8h2M13 8h2M3.5 3.5l1.4 1.4M11.1 11.1l1.4 1.4M12.5 3.5l-1.4 1.4M4.9 11.1l-1.4 1.4"
                stroke="currentColor" stroke-width="1.2" stroke-linecap="square"/>
          <circle cx="8" cy="8" r="2.6" stroke="currentColor" stroke-width="1.2"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--surface-0) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: var(--hairline) solid var(--line);
  }
  .nav__in {
    display: flex; align-items: center; gap: var(--s-5);
    height: 56px;
  }

  /* Identity mark — reads as an asset tag, not a logo */
  .mark { display: flex; align-items: center; gap: var(--s-3); margin-right: auto; }
  .mark__id {
    font-family: var(--font-mono); font-weight: 700;
    font-size: var(--t-sm); letter-spacing: 0.18em; color: var(--text);
  }
  .mark__sep { width: 1px; height: 14px; background: var(--line-bright); }
  .mark__role { transition: color var(--t-fast) var(--ease); }
  .mark:hover .mark__role { color: var(--text-dim); }


  .nav__links { display: flex; align-items: center; gap: var(--s-4); margin-right: var(--s-4); }
  .nav__link { color: var(--text-faint); transition: color var(--t-fast) var(--ease); }
  .nav__link:hover { color: var(--text); }
  .nav__link[aria-current="page"] { color: var(--text); }

  .nav__tools { display: flex; align-items: center; gap: var(--s-3); }

  .lang { display: flex; border: var(--hairline) solid var(--line); border-radius: var(--radius); }
  .lang__opt {
    font-family: var(--font-mono); font-size: var(--t-xs); letter-spacing: 0.08em;
    padding: 4px 8px; color: var(--text-faint);
    transition: color var(--t-fast) var(--ease), background var(--t-fast) var(--ease);
  }
  .lang__opt + .lang__opt { border-left: var(--hairline) solid var(--line); }
  .lang__opt:hover { color: var(--text); }
  .lang__opt[aria-current="true"] { color: var(--text); background: var(--surface-2); }

  .tgl {
    display: grid; place-items: center;
    width: 26px; height: 26px; padding: 0;
    background: transparent; color: var(--text-faint);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius); cursor: pointer;
    transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
  }
  .tgl:hover { color: var(--text); border-color: var(--line-bright); }

  @media (max-width: 720px) {
    .mark__sep, .mark__role { display: none; }
  }
</style>
