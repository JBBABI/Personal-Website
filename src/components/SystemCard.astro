---
import { useTranslations, type Lang } from '../i18n/ui';
interface Props {
  lang: Lang; index: number; placeholder: boolean;
  title: string; summary: string; role: string; stack: string[];
  autonomy: string; outcome: string; year?: string;
  links?: { label: string; href: string }[];
}
const { lang, index, placeholder, title, summary, role, stack, autonomy, outcome, year, links = [] } = Astro.props;
const t = useTranslations(lang);

const rows = [
  { k: t('systems.role'),     v: role },
  { k: t('systems.autonomy'), v: autonomy },
  { k: t('systems.outcome'),  v: outcome, strong: true },
];
---
<article class:list={['sys', placeholder && 'sys--ph']}>
  <div class="sys__bar">
    <span class="num sys__idx">{String(index).padStart(2, '0')}</span>
    {year && <span class="label sys__year">{year}</span>}
    {placeholder && <span class="label sys__flag">Slot</span>}
  </div>

  <div class="sys__main">
    <h3 class="sys__title">{title}</h3>
    <p class="prose sys__summary">{summary}</p>

    <dl class="sys__rows">
      {rows.map(r => (
        <div class="sys__row">
          <dt class="label">{r.k}</dt>
          <dd class:list={['sys__v', r.strong && 'sys__v--strong']}>{r.v}</dd>
        </div>
      ))}
    </dl>

    <div class="sys__foot">
      <ul class="sys__stack">
        {stack.map(s => <li class="mono sys__chip">{s}</li>)}
      </ul>
      {links.length > 0 && (
        <ul class="sys__links">
          {links.map(l => (
            <li><a class="link mono sys__link" href={l.href} target="_blank" rel="noopener noreferrer">{l.label} ↗</a></li>
          ))}
        </ul>
      )}
    </div>
  </div>
</article>

<style>
  .sys {
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-1);
    display: flex; flex-direction: column;
    transition: border-color var(--t-base-dur) var(--ease), background var(--t-base-dur) var(--ease);
  }
  .sys:hover { border-color: var(--line-bright); background: var(--surface-2); }

  /* Placeholder slots read as unfilled hardware bays, not as claims. */
  .sys--ph { border-style: dashed; background: transparent; }
  .sys--ph .sys__title, .sys--ph .sys__v { color: var(--text-dim); }

  .sys__bar {
    display: flex; align-items: center; gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    border-bottom: var(--hairline) solid var(--line);
  }
  .sys__idx { font-size: var(--t-xs); color: var(--text-faint); }
  .sys__year { margin-left: auto; }
  .sys__flag {
    margin-left: auto; color: var(--text-faint);
    border: var(--hairline) dashed var(--line-bright);
    padding: 1px 6px; border-radius: var(--radius);
  }

  .sys__main { padding: var(--s-5) var(--s-4) var(--s-4); display: flex; flex-direction: column; gap: var(--s-4); flex: 1; }
  .sys__title { font-size: var(--t-lg); }
  .sys__summary { font-size: var(--t-sm); }

  .sys__rows { display: flex; flex-direction: column; gap: var(--s-3); margin: 0; }
  .sys__row { display: grid; grid-template-columns: 5.5rem 1fr; gap: var(--s-3); align-items: baseline; }
  .sys__row dt { padding-top: 2px; }
  .sys__v { margin: 0; font-size: var(--t-sm); color: var(--text-dim); }
  .sys__v--strong { color: var(--text); }

  .sys__foot { margin-top: auto; padding-top: var(--s-4); border-top: var(--hairline) solid var(--line); display: flex; flex-direction: column; gap: var(--s-3); }
  .sys__stack, .sys__links { display: flex; flex-wrap: wrap; gap: var(--s-2); list-style: none; margin: 0; padding: 0; }
  .sys__chip {
    font-size: var(--t-xs); color: var(--text-faint);
    border: var(--hairline) solid var(--line);
    padding: 2px 7px; border-radius: var(--radius);
  }
  .sys__link { font-size: var(--t-xs); }

  @media (max-width: 460px) {
    .sys__row { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
