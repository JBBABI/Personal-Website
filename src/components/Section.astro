---
interface Props { id: string; label: string; title: string; intro?: string; }
const { id, label, title, intro } = Astro.props;
---
<section id={id} class="sec">
  <div class="wrap">
    <div class="sec__head">
      <span class="label sec__label">{label}</span>
      <h2 class="sec__title">{title}</h2>
      {intro && <p class="prose sec__intro">{intro}</p>}
    </div>
    <slot />
  </div>
</section>

<style>
  .sec { padding-block: var(--s-9); border-top: var(--hairline) solid var(--line); }
  .sec__head { margin-bottom: var(--s-7); }
  .sec__label {
    display: block; margin-bottom: var(--s-4);
    padding-bottom: var(--s-3);
    border-bottom: var(--hairline) solid var(--line);
  }
  .sec__title { margin-bottom: var(--s-4); }
  .sec__intro { font-size: var(--t-md); }
</style>
