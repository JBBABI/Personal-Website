---
/* ============================================================================
   The research index: a filterable list of every paper matching the seed
   terms. Not a "best papers" feed — no ranking, no editorial. Every tag is a
   property a reader can check against the paper itself.

   Two constraints from BRAND.md shape most of what follows:

   AMBER IS LIVE STATE ONLY. The obvious way to show an active filter is to
   light it up, and amber is the only colour available — but spending it here
   would leave the page with seven lit chips and no way to say "this is live".
   Active filters invert instead, off-white on black, which is louder than
   amber anyway. The one amber element on the page is the update dot, which is
   genuinely a status lamp.

   NO REVEAL-ON-SCROLL. So the list pages with an explicit button rather than
   loading as you scroll. That also keeps the footer reachable, which infinite
   scroll never does.
   ========================================================================== */
import { readFileSync } from 'node:fs';
import { useTranslations, type Lang } from '../i18n/ui';

/* Read from public/ at build time — the same file the browser fetches, so the
   server-rendered first page and the client's full list can never disagree.
   Generated by `npm run research:index`. */
const index = JSON.parse(readFileSync('public/research-index.json', 'utf8')) as {
  generated: string; total: number; filters: string[];
  papers: { id: string; title: string; authors: string[]; more: number;
            date: string; tags: string[]; type: string | null; unsure: boolean }[];
};

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

/* The first page is rendered as HTML at build time rather than drawn by
   JavaScript on load. The index has to be readable — and indexable — without
   scripts, and a list of papers is exactly the kind of content that should
   survive a failed bundle. Filtering is the only part that needs JS. */
const PAGE = 50;
const first = index.papers.slice(0, PAGE);

const fmtDate = (iso: string) => iso;
---

<section class="ri">
  <header class="ri__head">
    <h1 class="ri__title">{t('research.title')}</h1>
    <p class="ri__lede">{t('research.lede')}</p>

    <p class="ri__meta label">
      <span data-count>{index.total.toLocaleString(lang === 'fr' ? 'fr-FR' : 'en-US')}</span>
      <span>{t('research.papers')}</span>
      <span class="ri__sep" aria-hidden="true"></span>
      <span class="ri__live" aria-hidden="true"></span>
      <span>{t('research.updated')} {index.generated}</span>
    </p>
  </header>

  <!-- Filters. A <button> each, because they toggle state rather than
       navigate; anchors here would promise a destination they do not have. -->
  <div class="ri__filters" role="group" aria-label={t('research.filterLabel')}>
    {index.filters.map((f) => (
      <button class="chip" type="button" data-filter={f} aria-pressed="false">{f}</button>
    ))}
    <button class="chip chip--clear" type="button" data-clear hidden>{t('research.clear')}</button>
  </div>

  <p class="ri__status label" data-status hidden></p>

  <ol class="ri__list" data-list>
    {first.map((p) => (
      <li class="paper" data-tags={p.tags.join(',')} data-unsure={p.unsure ? '1' : '0'}>
        <a class="paper__title" href={`https://arxiv.org/abs/${p.id}`}
           target="_blank" rel="noopener noreferrer">{p.title}</a>
        <p class="paper__by label">
          <span class="paper__authors">
            {p.authors.join(', ')}{p.more > 0 && <span class="paper__more"> +{p.more}</span>}
          </span>
          <span class="paper__date">{fmtDate(p.date)}</span>
        </p>
        <p class="paper__tags">
          {p.type && <span class="tag tag--type">{p.type}</span>}
          {p.tags.map((tg) => <span class="tag">{tg}</span>)}
          {p.unsure && <span class="tag tag--unsure" title={t('research.unsureHint')}>{t('research.unsure')}</span>}
        </p>
      </li>
    ))}
  </ol>

  <!-- The client clones this instead of building rows with createElement.

       Astro scopes component CSS with a generated data-astro-* attribute that
       it stamps onto elements IT renders. Nodes created in the browser never
       receive it, so a JS-built row silently loses every style in this file —
       tags run together as bare text and the layout collapses. Cloning a
       server-rendered node carries the attribute with it. -->
  <template data-row>
    <li class="paper">
      <a class="paper__title" target="_blank" rel="noopener noreferrer"></a>
      <p class="paper__by label">
        <span class="paper__authors"></span>
        <span class="paper__date"></span>
      </p>
      <p class="paper__tags"></p>
    </li>
  </template>
  <template data-tag><span class="tag"></span></template>
  <span hidden data-unsure-label={t('research.unsure')} data-unsure-hint={t('research.unsureHint')}></span>

  <button class="more" type="button" data-more>{t('research.more')}</button>

  <p class="ri__note">{t('research.note')}</p>
</section>

<script>
  /* All 4,683 rows live in one JSON file fetched after first paint. The 50
     rendered server-side cover the default view; the rest arrive only if a
     filter or the More button asks for them, so the common case costs nothing
     beyond the HTML already sent. */
  const PAGE = 50;

  const list = document.querySelector<HTMLOListElement>('[data-list]')!;
  const moreBtn = document.querySelector<HTMLButtonElement>('[data-more]')!;
  const clearBtn = document.querySelector<HTMLButtonElement>('[data-clear]')!;
  const statusEl = document.querySelector<HTMLParagraphElement>('[data-status]')!;
  const countEl = document.querySelector<HTMLElement>('[data-count]')!;
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];

  type Paper = {
    id: string; title: string; authors: string[]; more: number;
    date: string; tags: string[]; type: string | null; unsure: boolean;
  };

  let all: Paper[] | null = null;
  let shown = PAGE;
  const active = new Set<string>();

  /* Labels come from the server-rendered markup rather than being hard-coded
     here, so the French page says "incertain" and not "unsure". */
  /* Read from a dedicated element rather than scraped off a rendered row: the
     first 50 papers may contain no unsure one, and then the French page
     silently labelled its tags in English. */
  const labels = document.querySelector<HTMLElement>('[data-unsure-label]')!;
  const strings = {
    unsure: labels.dataset.unsureLabel!,
    unsureHint: labels.dataset.unsureHint!,
    of: document.documentElement.lang === 'fr' ? 'sur' : 'of',
  };

  const rowTpl = document.querySelector<HTMLTemplateElement>('[data-row]')!;
  const tagTpl = document.querySelector<HTMLTemplateElement>('[data-tag]')!;

  async function load(): Promise<Paper[]> {
    if (all) return all;
    const res = await fetch('/research-index.json');
    all = (await res.json()).papers as Paper[];
    return all;
  }

  function matches(p: Paper) {
    // Filters intersect: choosing security AND memory asks for papers that
    // are both, not either. Union would grow the result set as you add
    // constraints, which is the opposite of what picking a filter means.
    for (const f of active) if (!p.tags.includes(f)) return false;
    return true;
  }

  function tag(text: string, extra?: string) {
    const el = tagTpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
    el.textContent = text;
    if (extra) el.classList.add(extra);
    return el;
  }

  function row(p: Paper) {
    const li = rowTpl.content.firstElementChild!.cloneNode(true) as HTMLLIElement;

    const a = li.querySelector('a.paper__title') as HTMLAnchorElement;
    a.href = `https://arxiv.org/abs/${p.id}`;
    // textContent, not innerHTML: titles come from arXiv and are not ours.
    a.textContent = p.title;

    li.querySelector('.paper__authors')!.textContent =
      p.authors.join(', ') + (p.more > 0 ? ` +${p.more}` : '');
    li.querySelector('.paper__date')!.textContent = p.date;

    const tags = li.querySelector('.paper__tags')!;
    if (p.type) tags.appendChild(tag(p.type, 'tag--type'));
    for (const t of p.tags) tags.appendChild(tag(t));
    if (p.unsure) {
      const u = tag(strings.unsure, 'tag--unsure');
      u.title = strings.unsureHint;      // the server-rendered rows carry this too
      tags.appendChild(u);
    }

    return li;
  }

  async function render() {
    const papers = await load();
    const hits = papers.filter(matches);

    list.replaceChildren(...hits.slice(0, shown).map(row));
    countEl.textContent = hits.length.toLocaleString();
    moreBtn.hidden = shown >= hits.length;
    clearBtn.hidden = active.size === 0;

    if (active.size > 0) {
      statusEl.hidden = false;
      statusEl.textContent = `${hits.length} ${strings.of} ${papers.length}`;
    } else {
      statusEl.hidden = true;
    }
  }

  /* Filter state lives in the URL so a filtered view can be linked to. A
     shared link that silently drops the filters is worse than no sharing at
     all — the recipient sees a different page and has no way to know. */
  function syncUrl() {
    const url = new URL(location.href);
    if (active.size) url.searchParams.set('f', [...active].join(','));
    else url.searchParams.delete('f');
    history.replaceState(null, '', url);
  }

  function readUrl() {
    const raw = new URL(location.href).searchParams.get('f');
    if (!raw) return;
    const known = new Set(chips.map((c) => c.dataset.filter!));
    for (const f of raw.split(',')) {
      // Ignore anything not a real filter: a stale or hand-edited link should
      // show an unfiltered index, never an empty one with no explanation.
      if (known.has(f)) active.add(f);
    }
    for (const c of chips) {
      c.setAttribute('aria-pressed', active.has(c.dataset.filter!) ? 'true' : 'false');
    }
  }

  for (const chip of chips) {
    chip.addEventListener('click', () => {
      const f = chip.dataset.filter!;
      if (active.has(f)) active.delete(f); else active.add(f);
      chip.setAttribute('aria-pressed', active.has(f) ? 'true' : 'false');
      shown = PAGE;                       // a new filter starts at the top
      syncUrl();
      render();
    });
  }

  clearBtn.addEventListener('click', () => {
    active.clear();
    for (const c of chips) c.setAttribute('aria-pressed', 'false');
    shown = PAGE;
    syncUrl();
    render();
  });

  moreBtn.addEventListener('click', () => {
    shown += PAGE;
    render();
  });

  readUrl();
  if (active.size) render();              // a linked filtered view renders at once
  else load();                            // otherwise just warm the cache
</script>

<style>
  .ri { padding-block: var(--s-7) var(--s-8); }

  .ri__title {
    font-size: var(--t-xl); letter-spacing: -0.028em;
    margin: 0 0 var(--s-3);
  }
  .ri__lede {
    color: var(--text-dim); max-width: var(--measure);
    margin: 0 0 var(--s-5);
  }

  .ri__meta {
    display: flex; align-items: center; gap: var(--s-2);
    color: var(--text-faint); margin: 0 0 var(--s-6);
    font-variant-numeric: tabular-nums;
  }
  .ri__sep { width: 1px; height: 11px; background: var(--line-bright); margin-inline: var(--s-1); }

  /* The only amber on the page. The index genuinely updates on a schedule, so
     this is a status lamp rather than decoration. */
  .ri__live {
    width: 5px; height: 5px; border-radius: 50%;
    background: var(--signal); box-shadow: 0 0 0 3px var(--signal-dim);
    animation: pulse 2.4s var(--ease) infinite;
  }
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.45; } }
  @media (prefers-reduced-motion: reduce) { .ri__live { animation: none; } }

  /* --- filters ---------------------------------------------------------- */

  .ri__filters {
    display: flex; flex-wrap: wrap; gap: var(--s-2);
    padding-bottom: var(--s-5);
    border-bottom: var(--hairline) solid var(--line);
  }

  .chip {
    font-family: var(--font-mono); font-size: var(--t-xs);
    letter-spacing: 0.12em; text-transform: uppercase;
    padding: 6px 10px; cursor: pointer;
    color: var(--text-dim); background: transparent;
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
    transition: color var(--t-fast) var(--ease),
                border-color var(--t-fast) var(--ease),
                background var(--t-fast) var(--ease);
  }
  .chip:hover { color: var(--text); border-color: var(--line-bright); }

  /* Inversion, not amber. See the note at the top of this file. */
  .chip[aria-pressed="true"] {
    color: var(--surface-0); background: var(--text); border-color: var(--text);
  }
  .chip--clear { color: var(--text-faint); border-style: dashed; }

  .ri__status { color: var(--text-faint); margin: var(--s-4) 0 0; font-variant-numeric: tabular-nums; }

  /* --- the list --------------------------------------------------------- */

  .ri__list { list-style: none; margin: 0; padding: 0; }

  .paper {
    padding-block: var(--s-5);
    border-bottom: var(--hairline) solid var(--line);
  }

  .paper__title {
    display: block; font-size: var(--t-md); line-height: 1.4;
    letter-spacing: -0.012em; color: var(--text); text-decoration: none;
    transition: color var(--t-fast) var(--ease);
  }
  .paper__title:hover { color: var(--text-dim); text-decoration: underline; text-underline-offset: 3px; }

  .paper__by {
    display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-4);
    color: var(--text-faint); margin: var(--s-2) 0 0;
    font-variant-numeric: tabular-nums;
  }
  .paper__more { color: var(--text-faint); }

  .paper__tags { display: flex; flex-wrap: wrap; gap: var(--s-2); margin: var(--s-3) 0 0; }

  .tag {
    font-family: var(--font-mono); font-size: var(--t-xs);
    letter-spacing: 0.12em; text-transform: uppercase;
    padding: 2px 6px; color: var(--text-dim);
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
  }
  .tag--type { color: var(--text); border-color: var(--line-bright); }
  /* Marked, not hidden, and quiet enough not to read as a warning. */
  .tag--unsure { color: var(--text-faint); border-style: dashed; }

  /* [hidden] must win over the display below, or `moreBtn.hidden = true` is
     silently ignored: a class selector outranks the UA sheet's [hidden] rule.
     Same for the status line and the clear chip. */
  .more[hidden], .ri__status[hidden], .chip[hidden] { display: none; }

  .more {
    display: block; width: 100%; margin-top: var(--s-6);
    font-family: var(--font-mono); font-size: var(--t-xs);
    letter-spacing: 0.12em; text-transform: uppercase;
    padding: var(--s-3); cursor: pointer;
    color: var(--text-dim); background: transparent;
    border: var(--hairline) solid var(--line); border-radius: var(--radius);
    transition: color var(--t-fast) var(--ease), border-color var(--t-fast) var(--ease);
  }
  .more:hover { color: var(--text); border-color: var(--line-bright); }

  .ri__note {
    color: var(--text-faint); font-size: var(--t-sm);
    max-width: var(--measure); margin: var(--s-6) 0 0;
  }

  @media (max-width: 560px) {
    .paper__by { flex-direction: column; gap: var(--s-1); }
  }
</style>
