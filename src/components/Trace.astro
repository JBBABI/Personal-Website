---
import { useTranslations, type Lang } from '../i18n/ui';
import { trace } from '../data/trace';
interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);

const fmt = new Intl.NumberFormat(lang === 'fr' ? 'fr-FR' : 'en-US');
const secs = (ms: number) => `${(ms / 1000).toFixed(2)}s`;
const total = trace.steps.reduce((a, s) => a + s.ms, 0);

const stats = [
  { k: t('trace.run'),    v: trace.runId, wide: true },
  { k: t('trace.model'),  v: trace.model, wide: true },
  { k: t('trace.wall'),   v: secs(trace.wallMs) },
  { k: t('trace.tokens'), v: fmt.format(trace.tokensIn + trace.tokensOut) },
  { k: t('trace.cost'),   v: `$${trace.costUsd.toFixed(4)}` },
  { k: t('trace.steps'),  v: String(trace.steps.length) },
];
---
<div class="tr">
  {trace.sample && (
    <p class="tr__warn label">
      Sample structure — replace with a real run in <code>src/data/trace.ts</code>
    </p>
  )}

  <div class="tr__head">
    <span class="live">{trace.status === 'ok' ? t('trace.ok') : trace.status}</span>
    <dl class="tr__stats">
      {stats.map(s => (
        <div class:list={['tr__stat', s.wide && 'tr__stat--wide']}>
          <dt class="label">{s.k}</dt>
          <dd class="num tr__val">{s.v}</dd>
        </div>
      ))}
    </dl>
  </div>

  <ol class="tr__steps">
    {trace.steps.map(s => (
      <li class="tr__step">
        <details class="tr__d">
          <summary class="tr__sum">
            <span class="num tr__n">{String(s.n).padStart(2, '0')}</span>
            <span class:list={['tr__kind', `tr__kind--${s.kind}`]}>{s.kind}</span>
            <span class="tr__label">{s.label}</span>
            <span class="num tr__ms">{secs(s.ms)}</span>
            <span class="num tr__tok">{fmt.format(s.tokens)}</span>
            <span class="tr__chev" aria-hidden="true">+</span>
          </summary>
          <div class="tr__body">
            <p class="tr__detail">{s.detail}</p>
            <div class="tr__bar" aria-hidden="true">
              <span style={`width:${((s.ms / total) * 100).toFixed(1)}%`}></span>
            </div>
          </div>
        </details>
      </li>
    ))}
  </ol>
</div>

<style>
  .tr {
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-1);
    overflow: hidden;
  }

  .tr__warn {
    margin: 0; padding: var(--s-2) var(--s-4);
    background: var(--signal-dim);
    color: var(--signal);
    border-bottom: var(--hairline) solid var(--line);
    text-transform: none; letter-spacing: 0.04em;
  }
  .tr__warn code { font-family: var(--font-mono); }

  .tr__head {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: var(--s-4) var(--s-6);
    padding: var(--s-4);
    border-bottom: var(--hairline) solid var(--line);
    background: var(--surface-2);
  }
  .tr__stats {
    display: flex; flex-wrap: wrap; gap: var(--s-4) var(--s-6);
    margin: 0; margin-left: auto;
  }
  .tr__stat { display: flex; flex-direction: column; gap: 2px; }
  .tr__stat dt { margin: 0; }
  .tr__val { margin: 0; font-size: var(--t-sm); color: var(--text); }
  .tr__stat--wide .tr__val { color: var(--text-dim); }

  .tr__steps { list-style: none; margin: 0; padding: 0; }
  .tr__step + .tr__step { border-top: var(--hairline) solid var(--line); }

  .tr__sum {
    display: grid;
    grid-template-columns: 2.5rem 4.5rem 1fr auto auto 1.25rem;
    align-items: center; gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    cursor: pointer;
    transition: background var(--t-fast) var(--ease);
    list-style: none;
  }
  .tr__sum::-webkit-details-marker { display: none; }
  .tr__sum:hover { background: var(--surface-2); }

  .tr__n    { font-size: var(--t-xs); color: var(--text-faint); }
  .tr__kind {
    font-family: var(--font-mono); font-size: var(--t-xs);
    letter-spacing: 0.08em; text-transform: uppercase;
    padding: 2px 6px; border-radius: var(--radius);
    border: var(--hairline) solid var(--line-bright);
    color: var(--text-faint); text-align: center;
  }
  .tr__kind--result { color: var(--signal); border-color: var(--signal); }
  .tr__label { font-size: var(--t-sm); color: var(--text); }
  .tr__ms    { font-size: var(--t-xs); color: var(--text-dim); }
  .tr__tok   { font-size: var(--t-xs); color: var(--text-faint); }
  .tr__chev  {
    font-family: var(--font-mono); color: var(--text-faint);
    text-align: center; transition: transform var(--t-fast) var(--ease);
  }
  .tr__d[open] .tr__chev { transform: rotate(45deg); }

  .tr__body {
    padding: 0 var(--s-4) var(--s-4) calc(2.5rem + 4.5rem + var(--s-4) + var(--s-3) * 2);
    background: var(--surface-inset);
  }
  .tr__detail {
    font-size: var(--t-sm); color: var(--text-dim);
    max-width: var(--measure); padding-top: var(--s-3);
  }
  .tr__bar {
    margin-top: var(--s-3); height: 2px;
    background: var(--line); border-radius: 1px;
  }
  .tr__bar span { display: block; height: 100%; background: var(--signal); }

  @media (max-width: 720px) {
    .tr__sum { grid-template-columns: 2rem 1fr auto 1.25rem; row-gap: var(--s-2); }
    .tr__kind { grid-column: 1 / -1; grid-row: 2; justify-self: start; }
    .tr__tok { display: none; }
    .tr__body { padding-left: var(--s-4); }
  }
</style>
