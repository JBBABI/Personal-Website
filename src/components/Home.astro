---
import { useTranslations, type Lang } from '../i18n/ui';
import { now } from '../data/now';

interface Props { lang: Lang; }
const { lang } = Astro.props;
const t = useTranslations(lang);
const current = now[lang];

const links = [
  { k: t('contact.linkedin'), v: '/in/jean-baptiste-bonvarlet', href: 'https://www.linkedin.com/in/jean-baptiste-bonvarlet/' },
];
---
<div class="wrap page">
  <header class="id">
    {/* The dots are decoration, not language: hidden from assistive tech so
        the accessible name stays "Welcome" rather than "Welcome dot dot dot". */}
    <h1 class="id__name">{t('hero.welcome')}<span class="dots" aria-hidden="true"
      ><span></span><span></span><span></span></span></h1>
    <p class="prose intro">{t('hero.intro')}</p>
  </header>

  <section class="now" aria-labelledby="now-h">
    <div class="now__head">
      <h2 id="now-h" class="live now__label">{t('now.label')}</h2>
      <span class="label now__when">{t('now.updated')} {current.updated}</span>
    </div>
    <ul class="now__list">
      {current.lines.map(l => <li class="now__item">{l}</li>)}
    </ul>
  </section>

  <section class="els" aria-labelledby="els-h">
    <h2 id="els-h" class="label els__label">{t('contact.label')}</h2>
    <dl class="els__list">
      {links.map(l => (
        <div class="els__row">
          <dt class="label">{l.k}</dt>
          <dd class="els__v">
            <a class="link mono" href={l.href}
               target={l.href.startsWith('http') ? '_blank' : undefined}
               rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{l.v}</a>
          </dd>
        </div>
      ))}
    </dl>
  </section>
</div>

<style>
  .page {
    padding-block: clamp(var(--s-7), 11vh, var(--s-9));
    display: flex; flex-direction: column;
    gap: var(--s-7);
  }

  /* ---------- identity ---------- */
  .id__name { font-size: var(--t-xl); }
  .intro { font-size: var(--t-md); margin-top: var(--s-5); }

  /* ---------- the prompt: a loading indicator ----------
     Cycles blank -> . -> .. -> ... -> blank, the way a terminal shows it is
     still working. Each dot has its own keyframes because they all have to
     clear on the SAME tick at the end of the cycle; staggered delays on one
     shared keyframe would clear them one by one instead, which reads as a
     line being erased rather than a loop restarting.

     steps(1, end) means every dot SNAPS on and off with no fade, per the
     motion rule in BRAND.md. 1.2s is exactly half the live dot's 2.4s pulse,
     so the two stay harmonic instead of drifting against each other.

     Animating opacity (not display or visibility) keeps all three dots in
     the layout at all times, so the heading never reflows as they cycle.

     Neutral grey, never amber: amber marks live state only (BRAND.md), and
     an ellipsis is decoration, not a status lamp. */
  .dots {
    display: inline-flex;
    gap: 0.06em;
    margin-left: 0.04em;
    color: var(--text-dim);
  }
  .dots span {
    /* Visible by default so the dots degrade to a plain static ellipsis
       wherever the animation does not run. */
    opacity: 1;
    animation-duration: 1.2s;
    animation-timing-function: steps(1, end);
    animation-iteration-count: infinite;
  }
  .dots span::before { content: "."; }

  .dots span:nth-child(1) { animation-name: dot1; }
  .dots span:nth-child(2) { animation-name: dot2; }
  .dots span:nth-child(3) { animation-name: dot3; }

  @keyframes dot1 { 0% { opacity: 0; } 25%, 100% { opacity: 1; } }
  @keyframes dot2 { 0% { opacity: 0; } 50%, 100% { opacity: 1; } }
  @keyframes dot3 { 0% { opacity: 0; } 75%, 100% { opacity: 1; } }

  /* Stated outright rather than leaning on the global reduced-motion reset:
     that one only clamps duration, which would still leave the dots blinking
     through a whole cycle on load. A blinking indicator is also exactly what
     someone setting this preference is asking not to see. */
  @media (prefers-reduced-motion: reduce) {
    /* :nth-child(n) is here to match the specificity of the three rules
       above. Plain `.dots span` loses to them, and animation-name would
       survive the override: the dots would still cycle, just clamped to
       0.01ms by the global reset rather than genuinely switched off. */
    .dots span:nth-child(n) { animation-name: none; opacity: 1; }
  }

  /* ---------- now ---------- */
  .now {
    border: var(--hairline) solid var(--line);
    border-radius: var(--radius);
    background: var(--surface-1);
  }
  .now__head {
    display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-3);
    padding: var(--s-3) var(--s-4);
    border-bottom: var(--hairline) solid var(--line);
  }
  .now__label { font-size: var(--t-xs); font-weight: 500; letter-spacing: 0.12em; }
  .now__when { margin-left: auto; }

  .now__list { list-style: none; margin: 0; padding: 0; }
  .now__item {
    padding: var(--s-3) var(--s-4);
    font-size: var(--t-sm);
    color: var(--text-dim);
  }
  .now__item + .now__item { border-top: var(--hairline) solid var(--line); }

  /* ---------- elsewhere ---------- */
  .els__label {
    display: block; padding-bottom: var(--s-3);
    border-bottom: var(--hairline) solid var(--line);
  }
  .els__list { margin: 0; }
  .els__row {
    display: grid; grid-template-columns: 5.5rem 1fr; gap: var(--s-4);
    padding: var(--s-3) 0; align-items: baseline;
    border-bottom: var(--hairline) solid var(--line);
  }
  .els__v { margin: 0; font-size: var(--t-sm); }

  @media (max-width: 460px) {
    .els__row { grid-template-columns: 1fr; gap: var(--s-1); }
  }
</style>
